{
  "name": "dsh-rp-bot",
  "version": "0.1.0",
  "private": true,
  "description": "RPLink community roleplay bot for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react",
        "react/jsx-runtime"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  }
}
