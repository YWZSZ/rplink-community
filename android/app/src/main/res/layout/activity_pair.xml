<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingTop="24dp"
        android:paddingRight="22dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pair_title"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="在电脑端 DSH 打开「设置 → RPLink」，生成配对二维码。"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <Button
            android:id="@+id/pair_scan"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_primary"
            android:text="@string/pair_scan"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="或粘贴配对链接"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/pair_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_secondary"
            android:hint="rplink://pair?…"
            android:inputType="textUri"
            android:minHeight="96dp"
            android:gravity="top|start"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textColorHint="#5E6C82"
            android:textSize="12sp" />

        <Button
            android:id="@+id/pair_submit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_secondary"
            android:text="@string/pair_submit"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/pair_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pair_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
